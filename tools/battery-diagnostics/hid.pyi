from typing import TypedDict

class DeviceInfo(TypedDict):
    path: bytes
    usage_page: int
    usage: int
    manufacturer_string: str

def enumerate(vendor_id: int = 0, product_id: int = 0) -> list[DeviceInfo]: ...

class device:
    def __init__(self) -> None: ...
    def open_path(self, path: bytes) -> None: ...
    def set_nonblocking(self, nonblock: int) -> int: ...
    def read(self, max_length: int, timeout_ms: int = 0) -> list[int]: ...
    def write(self, buff: bytes) -> int: ...
    def send_feature_report(self, buff: bytes) -> int: ...
    def get_feature_report(self, report_num: int, max_length: int) -> list[int]: ...
    def close(self) -> None: ...
