/* Stock physical layout: Copyright 2024 yangzheng20003 (@yangzheng20003). */
/* Physical order: maintained stock_keymap.h and keyboard.json LAYOUT.
 * Knob CCW/CW are appended after the 72 physical positions. */
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>
/* Board actions are supplied by the Studio profile; minimal wired builds
 * retain explicit no-ops for unavailable radio/settings features. */
#ifndef GMK70_BT1_BINDING
#define GMK70_BT1_BINDING &none
#define GMK70_BT2_BINDING &none
#define GMK70_BT3_BINDING &none
#define GMK70_DONGLE_BINDING &none
#define GMK70_RESET_BINDING &none
#define GMK70_BATTERY_BINDING &none
#define GMK70_CHARGING_BINDING &none
#define GMK70_FLIP_BINDING &none
#define GMK70_GUI_BINDING &none
#define GMK70_WINDOWS_BINDING &to 0
#define GMK70_MAC_BINDING &to 2
#endif
#ifndef GMK70_NKRO_BINDING
#    define GMK70_NKRO_BINDING &gmk_nkro 0
#endif
/ {
    keymap {
        compatible = "zmk,keymap";
        base_layer {
            display-name = "Windows";
            bindings = <
                &kp C_MUTE &kp ESC &kp GRAVE &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &kp N6 &kp N7 &kp N8 &kp N9 &kp N0 &kp MINUS &kp EQUAL &kp BSPC
                &kp LC(Z) &kp TAB &kp Q &kp W &kp E &kp R &kp T &kp Y &kp U &kp I &kp O &kp P &kp LBKT &kp RBKT &kp BSLH
                &kp LC(X) &kp CAPS &kp A &kp S &kp D &kp F &kp G &kp H &kp J &kp K &kp L &kp SEMI &kp SQT &kp RET
                &kp LC(C) &kp LSHFT &kp Z &kp X &kp C &kp V &kp B &kp B &kp N &kp M &kp COMMA &kp DOT &kp FSLH &kp RSHFT &kp UP &kp DEL
                &kp LC(V) &kp LCTRL &mo 1 &kp LALT &kp SPACE &kp SPACE &kp RALT &kp RGUI &kp LEFT &kp DOWN &kp RIGHT
                &kp C_VOL_DN &kp C_VOL_UP
            >;
        };
        function_layer {
            display-name = "Windows Fn";
            bindings = <
                &trans &trans &trans &kp F1 &kp F2 &kp F3 &kp F4 &kp F5 &kp F6 &kp F7 &kp F8 &kp F9 &kp F10 &kp F11 &kp F12 GMK70_RESET_BINDING
                &trans &rgb_ug RGB_EFF GMK70_BT1_BINDING GMK70_BT2_BINDING GMK70_BT3_BINDING GMK70_DONGLE_BINDING &trans &kp PSCRN &kp SLCK &kp PAUSE_BREAK &trans &trans &rgb_ug RGB_HUD &rgb_ug RGB_HUI &none /* QMK RL_MOD: independent logo effects unavailable. */
                &trans &trans &none GMK70_MAC_BINDING &trans &trans &trans &kp HOME &kp END &kp PG_UP &kp PG_DN &rgb_ug RGB_SAD &rgb_ug RGB_SAI &kp END
                &trans &trans &trans &rgb_ug RGB_TOG &trans GMK70_NKRO_BINDING GMK70_BATTERY_BINDING GMK70_BATTERY_BINDING &trans &trans &trans &trans &trans &none &rgb_ug RGB_BRI &kp INS
                &trans GMK70_FLIP_BINDING &trans &kp LALT GMK70_CHARGING_BINDING GMK70_CHARGING_BINDING &kp RALT GMK70_GUI_BINDING &rgb_ug RGB_SPD &rgb_ug RGB_BRD &rgb_ug RGB_SPI
                &trans &trans
            >;
        };
        mac_base_layer {
            display-name = "Mac";
            bindings = <
                &kp C_MUTE &kp ESC &kp GRAVE &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &kp N6 &kp N7 &kp N8 &kp N9 &kp N0 &kp MINUS &kp EQUAL &kp BSPC
                &kp LC(Z) &kp TAB &kp Q &kp W &kp E &kp R &kp T &kp Y &kp U &kp I &kp O &kp P &kp LBKT &kp RBKT &kp BSLH
                &kp LC(X) &kp CAPS &kp A &kp S &kp D &kp F &kp G &kp H &kp J &kp K &kp L &kp SEMI &kp SQT &kp RET
                &kp LC(C) &kp LSHFT &kp Z &kp X &kp C &kp V &kp B &kp B &kp N &kp M &kp COMMA &kp DOT &kp FSLH &kp RSHFT &kp UP &kp DEL
                &kp LC(V) &kp LCTRL &mo 3 &kp LGUI &kp SPACE &kp SPACE &kp RGUI &kp RALT &kp LEFT &kp DOWN &kp RIGHT
                &kp C_VOL_DN &kp C_VOL_UP
            >;
        };
        mac_function_layer {
            display-name = "Mac Fn";
            bindings = <
                &trans &trans &trans &kp F1 &kp F2 &kp F3 &kp F4 &kp F5 &kp F6 &kp F7 &kp F8 &kp F9 &kp F10 &kp F11 &kp F12 GMK70_RESET_BINDING
                &trans &rgb_ug RGB_EFF GMK70_BT1_BINDING GMK70_BT2_BINDING GMK70_BT3_BINDING GMK70_DONGLE_BINDING &trans &kp PSCRN &kp SLCK &kp PAUSE_BREAK &trans &trans &rgb_ug RGB_HUD &rgb_ug RGB_HUI &none /* QMK RL_MOD: independent logo effects unavailable. */
                &trans &trans GMK70_WINDOWS_BINDING &none &trans &trans &trans &kp HOME &kp END &kp PG_UP &kp PG_DN &rgb_ug RGB_SAD &rgb_ug RGB_SAI &kp END
                &trans &trans &trans &rgb_ug RGB_TOG &trans GMK70_NKRO_BINDING GMK70_BATTERY_BINDING GMK70_BATTERY_BINDING &trans &trans &trans &trans &trans &none &rgb_ug RGB_BRI &kp INS
                &trans GMK70_FLIP_BINDING &trans &kp LGUI GMK70_CHARGING_BINDING GMK70_CHARGING_BINDING &kp RGUI &kp RALT &rgb_ug RGB_SPD &rgb_ug RGB_BRD &rgb_ug RGB_SPI
                &trans &trans
            >;
        };
    };
};
