/* Stock physical layout: Copyright 2024 yangzheng20003 (@yangzheng20003). */
/* Physical order: maintained stock_keymap.h and keyboard.json LAYOUT.
 * Radio, encoder rotation and stock macro keys are intentionally inactive. */
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>
/ {
    keymap {
        compatible = "zmk,keymap";
        base_layer {
            display-name = "Windows";
            bindings = <
                &kp C_MUTE &kp ESC &kp GRAVE &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &kp N6 &kp N7 &kp N8 &kp N9 &kp N0 &kp MINUS &kp EQUAL &kp BSPC
                &none &kp TAB &kp Q &kp W &kp E &kp R &kp T &kp Y &kp U &kp I &kp O &kp P &kp LBKT &kp RBKT &kp BSLH
                &none &kp CAPS &kp A &kp S &kp D &kp F &kp G &kp H &kp J &kp K &kp L &kp SEMI &kp SQT &kp RET
                &none &kp LSHFT &kp Z &kp X &kp C &kp V &kp B &kp B &kp N &kp M &kp COMMA &kp DOT &kp FSLH &kp RSHFT &kp UP &kp DEL
                &none &kp LCTRL &mo 1 &kp LALT &kp SPACE &kp SPACE &kp RALT &kp RGUI &kp LEFT &kp DOWN &kp RIGHT
            >;
        };
        function_layer {
            display-name = "Windows Fn";
            bindings = <
                &trans &trans &trans &kp F1 &kp F2 &kp F3 &kp F4 &kp F5 &kp F6 &kp F7 &kp F8 &kp F9 &kp F10 &kp F11 &kp F12 &trans
                &trans &rgb_ug RGB_EFF &trans &trans &trans &trans &trans &kp PSCRN &kp SLCK &kp PAUSE_BREAK &trans &trans &rgb_ug RGB_HUD &rgb_ug RGB_HUI &rgb_ug RGB_EFR
                &trans &trans &none &to 2 &trans &trans &trans &kp HOME &kp END &kp PG_UP &kp PG_DN &rgb_ug RGB_SAD &rgb_ug RGB_SAI &kp END
                &trans &trans &trans &rgb_ug RGB_TOG &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &rgb_ug RGB_BRI &kp INS
                &trans &trans &trans &kp LALT &trans &trans &kp RALT &trans &rgb_ug RGB_SPD &rgb_ug RGB_BRD &rgb_ug RGB_SPI
            >;
        };
        mac_base_layer {
            display-name = "Mac";
            bindings = <
                &kp C_MUTE &kp ESC &kp GRAVE &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &kp N6 &kp N7 &kp N8 &kp N9 &kp N0 &kp MINUS &kp EQUAL &kp BSPC
                &none &kp TAB &kp Q &kp W &kp E &kp R &kp T &kp Y &kp U &kp I &kp O &kp P &kp LBKT &kp RBKT &kp BSLH
                &none &kp CAPS &kp A &kp S &kp D &kp F &kp G &kp H &kp J &kp K &kp L &kp SEMI &kp SQT &kp RET
                &none &kp LSHFT &kp Z &kp X &kp C &kp V &kp B &kp B &kp N &kp M &kp COMMA &kp DOT &kp FSLH &kp RSHFT &kp UP &kp DEL
                &none &kp LCTRL &mo 3 &kp LGUI &kp SPACE &kp SPACE &kp RGUI &kp RALT &kp LEFT &kp DOWN &kp RIGHT
            >;
        };
        mac_function_layer {
            display-name = "Mac Fn";
            bindings = <
                &trans &trans &trans &kp F1 &kp F2 &kp F3 &kp F4 &kp F5 &kp F6 &kp F7 &kp F8 &kp F9 &kp F10 &kp F11 &kp F12 &trans
                &trans &rgb_ug RGB_EFF &trans &trans &trans &trans &trans &kp PSCRN &kp SLCK &kp PAUSE_BREAK &trans &trans &rgb_ug RGB_HUD &rgb_ug RGB_HUI &rgb_ug RGB_EFR
                &trans &trans &to 0 &none &trans &trans &trans &kp HOME &kp END &kp PG_UP &kp PG_DN &rgb_ug RGB_SAD &rgb_ug RGB_SAI &kp END
                &trans &trans &trans &rgb_ug RGB_TOG &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &rgb_ug RGB_BRI &kp INS
                &trans &trans &trans &kp LGUI &trans &trans &kp RGUI &kp RALT &rgb_ug RGB_SPD &rgb_ug RGB_BRD &rgb_ug RGB_SPI
            >;
        };
    };
};
