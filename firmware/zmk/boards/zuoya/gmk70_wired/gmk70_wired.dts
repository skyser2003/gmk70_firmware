/* SPDX-License-Identifier: Apache-2.0 */
/dts-v1/;
#include <westberry/wb32fq95.dtsi>
#include <dt-bindings/zmk/matrix_transform.h>
#include <zephyr/dt-bindings/led/led.h>
/ {
    model = "ZUOYA GMK70 universal wired updater";
    compatible = "zuoya,gmk70-wired-board";
    chosen {
        zephyr,sram = &sram0;
        zephyr,flash = &flash0;
        zephyr,usb-device = &usb0;
        zmk,kscan = &kscan0;
        zmk,matrix-transform = &default_transform;
        zmk,underglow = &rgb_strip;
    };
    rgb_strip: rgb_strip {
        compatible = "zuoya,gmk70-rgb";
        chain-length = <77>;
        color-mapping = <LED_COLOR_ID_RED LED_COLOR_ID_GREEN LED_COLOR_ID_BLUE>;
    };
    kscan0: kscan {
        compatible = "zuoya,gmk70-wired";
    };
    default_transform: keymap_transform {
        compatible = "zmk,matrix-transform";
        rows = <10>;
        columns = <9>;
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,6) RC(0,7) RC(5,1) RC(5,2) RC(5,3) RC(5,4) RC(5,5) RC(5,6) RC(5,7) RC(5,8)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(1,6) RC(6,1) RC(6,2) RC(6,3) RC(6,4) RC(6,5) RC(6,6) RC(6,7) RC(6,8)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6) RC(7,1) RC(7,2) RC(7,3) RC(7,4) RC(7,5) RC(7,6) RC(7,7)
            RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5) RC(3,6) RC(8,0) RC(8,1) RC(8,2) RC(8,3) RC(8,4) RC(8,5) RC(8,6) RC(8,7) RC(8,8)
            RC(4,0) RC(4,1) RC(4,2) RC(4,3) RC(4,5) RC(9,1) RC(9,3) RC(9,4) RC(9,6) RC(9,7) RC(9,8)
        >;
    };
};
/* Application slot. Qualification overrides only this region in its overlay. */
&flash0 { reg = <0x08002000 0x1e000>; };
&usb0 { status = "okay"; };
