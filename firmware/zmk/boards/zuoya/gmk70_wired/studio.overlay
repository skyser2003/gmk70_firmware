/* The app-tail settings reservation is outside the admitted load region. */
&flash0 { reg = <0x08002000 0x1a000>; };
/ {
    chosen { zmk,studio-rpc-uart = &studio_uart; };
};
&usb0 {
    studio_uart: studio_uart {
        compatible = "zephyr,cdc-acm-uart";
    };
};
/ { keymap {
    base_layer { display-name = "Base"; };
    function_layer { display-name = "Fn"; };
}; };
