#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
/ {
    keymap {
        compatible = "zmk,keymap";
        default_layer {
            bindings = <
                &none &kp N6 &kp N7 &kp N8 &kp N9 &kp N0 &kp MINUS &kp EQUAL &kp BSPC
                &none &kp Y &kp U &kp I &kp O &kp P &kp LBKT &kp RBKT &kp BSLH
                &none &kp H &kp J &kp K &kp L &kp SEMI &kp SQT &kp ENTER &none
                &kp B &kp N &kp M &kp COMMA &kp DOT &kp SLASH &kp RSHIFT &kp UP &kp DELETE
                &none &kp SPACE &none &kp RALT &kp RGUI &none &kp LEFT &kp DOWN &kp RIGHT
            >;
        };
    };
};
