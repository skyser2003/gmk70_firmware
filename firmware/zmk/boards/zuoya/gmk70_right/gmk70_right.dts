/dts-v1/;
#include <westberry/wb32fq95.dtsi>
#include <dt-bindings/zmk/matrix_transform.h>

/ {
    model = "ZUOYA GMK70 right staging USB trial";
    compatible = "zuoya,gmk70-right";
    chosen {
        zephyr,sram = &sram0;
        zephyr,flash = &flash0;
        zephyr,usb-device = &usb0;
        zmk,kscan = &kscan0;
        zmk,matrix-transform = &default_transform;
    };
    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "row2col";
        debounce-press-ms = <5>;
        debounce-release-ms = <5>;
        poll-period-ms = <5>;
        row-gpios = <&gpioa 1 GPIO_ACTIVE_HIGH>, <&gpioa 2 GPIO_ACTIVE_HIGH>,
                    <&gpioa 3 GPIO_ACTIVE_HIGH>, <&gpioa 4 GPIO_ACTIVE_HIGH>,
                    <&gpioc 13 GPIO_ACTIVE_HIGH>;
        col-gpios = <&gpiob 13 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
                    <&gpiob 14 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
                    <&gpioc 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
                    <&gpioc 7 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
                    <&gpioc 8 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
                    <&gpioc 9 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
                    <&gpioc 4 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
                    <&gpioc 5 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,
                    <&gpiob 0 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;
    };
    default_transform: keymap_transform {
        compatible = "zmk,matrix-transform";
        rows = <5>;
        columns = <9>;
        map = <
            RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5) RC(0,6) RC(0,7) RC(0,8)
            RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5) RC(1,6) RC(1,7) RC(1,8)
            RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6) RC(2,7) RC(2,8)
            RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5) RC(3,6) RC(3,7) RC(3,8)
            RC(4,0) RC(4,1) RC(4,2) RC(4,3) RC(4,4) RC(4,5) RC(4,6) RC(4,7) RC(4,8)
        >;
    };
};
&usb0 { status = "okay"; };
