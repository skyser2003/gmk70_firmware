config GMK70_STANDALONE
    bool "GMK70 direct-boot firmware without a resident or upload receiver"
    depends on SOC_WB32FQ95 && KSCAN_GMK70_WIRED && ZMK_USB
    select REBOOT
    select SOC_RESET_HOOK

config GMK70_ZMK_UPDATER
    bool "GMK70 native raw HID firmware updater"
    depends on SOC_WB32FQ95 && KSCAN_GMK70_WIRED && ZMK_USB
    depends on !GMK70_STANDALONE
    select REBOOT
    select GMK70_NATIVE_UPDATE_WIRE
    help
      Development updater using the installed GMK70 resident ABI and wired
      relay. Requires two USB HID interfaces, interrupt OUT, and 32-byte HID
      endpoint buffers. Host writes require left USB, wired mode, a ready
      update service and the matching local/peer role. Permanent firmware never
      starts or feeds a hardware watchdog. This build is explicitly unlocked.

config GMK70_NATIVE_UPDATE_WIRE
    bool
    select RING_BUFFER
    select CRC
    help
      Reuse pinned native ZMK framing/parser and CRC32 for updater relay.

config GMK70_NATIVE_UPDATE_LEGACY_BRIDGE
    bool "Temporary native/legacy updater migration bridge"
    depends on GMK70_NATIVE_UPDATE_WIRE
    default n
    help
      Explicit migration build only: safely discover native-capable peers and
      retain RPC18 for older applications. Canonical builds use native frames.

config GMK70_STAGING_QUALIFICATION
    bool "GMK70 restricted staging qualification receiver"
    depends on GMK70_ZMK_UPDATER
    help
      Executing from staging: do not initialize or feed the permanent watchdog.
      Permit read-only identity/health and local BEGIN/ABORT only; BEGIN may
      erase the isolated commit page. Never stage DATA, SEAL, INSTALL or relay
      peer mutations. This image is experimental, not a permanent artifact.

config GMK70_RESIDENT_RECEIVER
    bool
    default y if GMK70_ZMK_UPDATER && !GMK70_STAGING_QUALIFICATION
    help
      Mark native startup as compatible with the unchanged resident handoff.
      Receiving through handoff does not require using it for outgoing updates.

config GMK70_ZMK_PEER_TRIAL_RELAY
    bool "GMK70 relay for qualification of an installed Vial right peer"
    depends on GMK70_ZMK_UPDATER && !GMK70_STAGING_QUALIFICATION
    help
      Forward validated trial ABI2 packets from left USB to target1 only.
      This enables staging qualification of a still-Vial right peer before
      replacing its application. No local trial execution or watchdog handoff
      is provided. Peer mutations require the ready update service and the same
      left/configured-USB/wired gates as the normal updater.
