function(zephyr_library_sources_ifdef config)
  if(${config})
    foreach(source IN LISTS ARGN)
      file(APPEND "${OUTPUT}" "${CMAKE_CURRENT_LIST_DIR}/${source}\n")
    endforeach()
  endif()
endfunction()
